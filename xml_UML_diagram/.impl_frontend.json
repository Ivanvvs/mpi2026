        "body": "{\r\n    if (session.role === 'STUDENT' && selectedExam.value?.exam.status === 'ACTIVE' && !document.fullscreenElement) {\r\n      reportClientExamViolation('FULLSCREEN_EXIT', 'Student left fullscreen mode during the exam')\r\n    }\r\n  }"
      },
