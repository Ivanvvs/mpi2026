        "body": "{\r\n    const startedAt = exam.startTime || exam.scheduledStartTime\r\n    if (!startedAt) return '-'\r\n    return parseServerDateTime(startedAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })\r\n  }"
