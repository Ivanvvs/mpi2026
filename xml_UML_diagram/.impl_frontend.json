  {
    "file": "frontend-vue/src/services/api.ts",
    "name": "api",
    "kind": "module",
    "fields": [
      {
        "name": "API_URL",
        "type": "\"http://localhost:8081\"",
        "visibility": "public",
        "initial": "'http://localhost:8081'"
      },
      {
        "name": "WS_URL",
        "type": "\"http://localhost:8081/ws\"",
        "visibility": "public",
        "initial": "`${API_URL}/ws`"
      }
    ],
    "ops": [
      {
        "name": "createApiClient",
        "visibility": "public",
        "type": "ApiClient",
        "params": [
          {
            "name": "session",
            "type": "SessionWithToken",
            "optional": false
          }
        ],
        "body": "{\r\n  return async function api<T>(path: string, options: RequestInit = {}): Promise<T> {\r\n    const response = await fetch(`${API_URL}${path}`, {\r\n      ...options,\r\n      headers: {\r\n        'Content-Type': 'application/json',\r\n        Authorization: `Bearer ${session.token}`,\r\n        ...(options.headers || {})\r\n      }\r\n    })\r\n    const text = await response.text()\r\n    const data = text ? JSON.parse(text) : null\r\n    if (!response.ok) {\r\n      throw new Error(data?.message || data?.error || `HTTP ${response.status}`)\r\n    }\r\n    return data as T\r\n  }\r\n}"
      }
    ]
  },
