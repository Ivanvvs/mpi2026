        "visibility": "private",
        "type": "string",
        "params": [
          {
            "name": "userId",
            "type": "number | null",
            "optional": false
          }
        ],
        "body": "{\r\n    if (!userId) return ''\r\n    return users.value.find((user) => user.id === userId)?.fullName || `ID ${userId}`\r\n  }"
      }
