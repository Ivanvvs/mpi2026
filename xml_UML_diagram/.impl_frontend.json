      {
        "name": "examRemainingLabel",
        "visibility": "public",
        "type": "string",
        "params": [
          {
            "name": "exam",
            "type": "ExamSession",
            "optional": false
          }
        ],
        "body": "{\r\n    if (!exam.durationMinutes) return '—'\r\n    const sourceStartTime = exam.scheduledStartTime || exam.startTime\r\n    const startTime = sourceStartTime ? parseServerDateTime(sourceStartTime).getTime() : Date.now()\r\n    const endTime = startTime + exam.durationMinutes * 60000\r\n    const remainingMs = endTime - now.value\r\n    if (remainingMs <= 0) return '00:00'\r\n    const minutes = Math.floor(remainingMs / 60000)\r\n    const seconds = Math.floor((remainingMs % 60000) / 1000)\r\n    return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`\r\n  }"
      },
      {
        "name": "examEndLabel",
        "visibility": "public",
        "type": "string",
        "params": [
          {
            "name": "exam",
            "type": "ExamSession",
            "optional": false
          }
        ],
        "body": "{\r\n    if (exam.endTime) {\r\n      return parseServerDateTime(exam.endTime).toLocaleString('ru-RU', {\r\n        day: '2-digit',\r\n        month: '2-digit',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      })\r\n    }\r\n\r\n    const sourceStartTime = exam.scheduledStartTime || exam.startTime\r\n    if (!sourceStartTime || !exam.durationMinutes) return '-'\r\n\r\n    const endTime = new Date(parseServerDateTime(sourceStartTime).getTime() + exam.durationMinutes * 60000)\r\n    return endTime.toLocaleString('ru-RU', {\r\n      day: '2-digit',\r\n      month: '2-digit',\r\n      hour: '2-digit',\r\n      minute: '2-digit'\r\n    })\r\n  }"
      },
      {
        "name": "loadExamDetails",
        "visibility": "private",
        "type": "Promise<void>",
        "params": [
          {
            "name": "id",
            "type": "number",
            "optional": false
          },
          {
            "name": "preserveQuestionIndex",
            "type": "boolean",
            "optional": false,
            "initial": "false"
          },
          {
            "name": "reconnectSocket",
            "type": "boolean",
            "optional": false,
            "initial": "false"
          }
        ],
        "body": "{\r\n    const previousIndex = currentQuestionIndex.value\r\n    const previousMonitorStudentId = selectedMonitorStudentId.value\r\n    selectedExam.value = await loadExamDetailsRequest(api, id)\r\n    localStorage.setItem('school-selected-exam-id', String(id))\r\n    currentQuestionIndex.value = preserveQuestionIndex\r\n      ? Math.min(previousIndex, Math.max(selectedExam.value.questions.length - 1, 0))\r\n      : 0\r\n    selectedMonitorStudentId.value = preserveQuestionIndex ? previousMonitorStudentId : null\r\n    selectedExam.value.questions.forEach((question) => {\r\n      const existing = selectedExam.value?.answers.find((answer) => answer.questionId === question.id && answer.userId === session.userId)\r\n      answerDrafts[question.id] = existing?.text || answerDrafts[question.id] || ''\r\n    })\r\n    classStudentsForSelectedExam.value.forEach((student) => {\r\n      gradeForm[student.id] = gradeForm[student.id] || 0\r\n    })\r\n    if (reconnectSocket && session.role === 'EXAMINER') connectExamSocket(id)\r\n    if (session.role === 'STUDENT' && selectedExam.value.exam.status === 'ACTIVE' && !currentExamSubmitted.value) {\r\n      requestExamFullscreen()\r\n    }\r\n  }"
      },
      {
        "name": "openExam",
        "visibility": "public",
