      {
        "name": "requestExamFullscreen",
        "visibility": "public",
        "type": "void",
        "params": [],
        "body": "{\r\n    if (document.fullscreenElement || !document.documentElement.requestFullscreen) return\r\n    document.documentElement.requestFullscreen().catch(() => {\r\n      reportClientExamViolation('FULLSCREEN_REQUEST_REJECTED', 'Student did not enter fullscreen mode')\r\n    })\r\n  }"
      },
      {
        "name": "reportClientExamViolation",
        "visibility": "public",
        "type": "Promise<void>",
        "params": [
          {
            "name": "type",
            "type": "string",
