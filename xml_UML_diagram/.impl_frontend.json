  {
    "file": "frontend-vue/src/services/examRealtime.ts",
    "name": "examRealtime",
    "kind": "module",
    "fields": [],
    "ops": [
      {
        "name": "connectExamRealtime",
        "visibility": "public",
        "type": "Client",
        "params": [
          {
            "name": "examId",
            "type": "number",
            "optional": false
          },
          {
            "name": "handlers",
            "type": "ExamRealtimeHandlers",
            "optional": false
          }
        ],
        "body": "{\n  const client = new Client({\n    webSocketFactory: () => new SockJS(WS_URL),\n    reconnectDelay: 3000,\n    onConnect: () => {\n      handlers.onConnected()\n      client.subscribe(`/topic/exams/${examId}`, (frame) => {\n        const payload = JSON.parse(frame.body) as Partial<ExamRealtimeMessage>\n        void handlers.onMessage({\n          type: payload.type || '',\n          userId: typeof payload.userId === 'number' ? payload.userId : null\n        })\n      })\n    },\n    onWebSocketError: handlers.onError\n  })\n  client.activate()\n  return client\n}"
      },
      {
        "name": "disconnectExamRealtime",
        "visibility": "public",
        "type": "void",
        "params": [
          {
            "name": "client",
            "type": "DeactivatableClient | null",
            "optional": false
          }
        ],
        "body": "{\n  client?.deactivate()\n}"
      }
    ]
  },
